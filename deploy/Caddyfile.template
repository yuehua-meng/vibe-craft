# 由 deploy/deploy.sh 自动生成，含密码哈希，已被 .gitignore 忽略。
# 如需修改域名或访问口令：删除本文件后重新运行 ./deploy/deploy.sh
__DOMAIN__ {
	encode zstd gzip
	# 看板页面的 JS 调 admin API 时会自带 Authorization: Bearer <管理员 Key>，
	# 这个头会顶掉浏览器缓存的 Basic 凭据，让 basic_auth 一直判定失败、
	# 反复弹出登录框且关不掉。这两条路径改由网关自身的 Bearer 鉴权保护
	# （静态资源不含机密，admin 接口没有管理员 Key 一律 401）。
	@basic not path /gateway/admin/* /gateway/static/*
	basic_auth @basic {
		__BASIC_AUTH_USER__ __BASIC_AUTH_HASH__
	}
	# 模型网关看板：/gateway/* 剥掉前缀后转发到内部服务 gateway:8020。
	# 需要先启动 agent-gateway 栈（它加入本项目的 vibe-craft_web 网络），否则返回 502。
	redir /gateway /gateway/ 308
	# 网关的模型代理入口只给容器内网使用，不通过边缘代理对外暴露。
	handle_path /gateway/v1/* {
		respond 404
	}
	handle_path /gateway/* {
		reverse_proxy gateway:8020
	}
	handle {
		reverse_proxy app:8010
	}
}
